# Copy to .env and fill in. Variables already set in the environment win over this file.

# Key clients send in the X-API-Key header.
API_KEY=change-me

# 64 hex chars that encrypt stored Garmin tokens. Generate once with
# `openssl rand -hex 32` and keep it: changing it makes every account reconnect.
TOKEN_ENC_KEY=

DB_PATH=data/garmin.db
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
